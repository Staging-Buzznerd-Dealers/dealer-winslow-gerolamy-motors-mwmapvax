    {
      "id": "sr-prior",
      "type": "radio",
      "label": "Have we serviced your vehicle before?",
      "required": true,
      "options": [
        {
          "value": "yes",
          "label": "Yes"
        },
        {
          "value": "no",
          "label": "No"
        }
