{
  "id": "bullet-list",
  "label": "Bullet list",
  "props": [
    {
      "key": "items",
      "type": "list",
      "label": "Items",
      "fields": [
        {
          "key": "text",
          "type": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "html": "<ul class=\"bl\">{{#each items}}<li>{{text}}</li>{{/each}}</ul>",
  "css": ".bl{list-style:none;margin:0;padding:0}.bl li{position:relative;padding-left:20px;margin:0 0 7px;font:400 13.5px/24px var(--font-body);color:var(--ink)}.bl li:last-child{margin-bottom:0}.bl li::before{content:\"\";position:absolute;left:2px;top:9px;width:6px;height:6px;background:var(--accent)}&.bz-block{padding:0}"
}
