{
  "version": 2,
  "id": "service-cards",
  "name": "Service cards",
  "props": [
    {
      "key": "cards",
      "type": "list",
      "label": "Cards",
      "fields": [
        {
          "key": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "key": "before",
          "type": "list",
          "label": "Paragraphs before the list",
          "fields": [
            {
              "key": "text",
              "type": "textarea",
              "label": "Paragraph"
            }
          ]
        },
        {
          "key": "points",
          "type": "list",
          "label": "Bullet points",
          "fields": [
            {
              "key": "text",
              "type": "text",
              "label": "Text"
            }
          ]
        },
        {
          "key": "after",
          "type": "textarea",
          "label": "Closing paragraph"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "sc",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0,
        "background": "card"
      },
      "children": [
        {
          "id": "sc-grid",
          "type": "row",
          "props": {
            "gap": 0,
            "align": "stretch",
            "stackOn": "never"
          },
          "children": [
            {
              "id": "sc-col",
              "type": "column",
              "props": {
                "span": 6,
                "repeat": "cards"
              },
              "children": [
                {
                  "id": "sc-card",
                  "type": "service-card",
                  "props": {
                    "title": "{{title}}",
                    "before": "{{before}}",
                    "points": "{{points}}",
                    "after": "{{after}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "css": "body :where([data-bz-node=\"sc\"]) .bz-block{padding:0}\nbody :where([data-bz-node=\"sc\"]) .bz-container{padding:0;max-width:none}\nbody [data-bz-node=\"sc\"]>.bz-container{padding-inline:0}\n\nbody [data-bz-node=\"sc\"]{background:#fff;padding:90px 0}\nbody [data-bz-node=\"sc\"]>.bz-container{max-width:var(--container)}\nbody [data-bz-node=\"sc-grid\"]{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;align-items:stretch}\nbody [data-bz-node^=\"sc-col-\"]{grid-column:auto;display:block}\n@media (max-width:1100px){body [data-bz-node=\"sc\"]{padding:64px 24px}}\n@media (max-width:820px){body [data-bz-node=\"sc-grid\"]{grid-template-columns:1fr}}\n@media (max-width:640px){body [data-bz-node=\"sc\"]{padding:48px 20px}body [data-bz-node=\"sc-grid\"]{gap:16px}}\n"
}
